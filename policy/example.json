{
  "version": 1,
  "description": "Example policy. Not loaded until M5.",
  "default": "deny",
  "rules": [
    {
      "container": "payments-api",
      "min_tls_version": "1.3",
      "allowed_ciphers": [
        "TLS_AES_128_GCM_SHA256",
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256"
      ]
    },
    {
      "container": "*",
      "min_tls_version": "1.2",
      "allowed_ciphers": [
        "TLS_AES_128_GCM_SHA256",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
      ]
    }
  ]
}
