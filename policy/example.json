{
  "version": 1,
  "default": "deny",
  "rules": [
    {
      "container": "payments-api",
      "min_version": "1.3",
      "ciphers": ["TLS_AES_128_GCM_SHA256", "TLS_AES_256_GCM_SHA384", "TLS_CHACHA20_POLY1305_SHA256"]
    },
    {
      "container": "*",
      "min_version": "1.2",
      "ciphers": ["TLS_AES_128_GCM_SHA256", "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"]
    }
  ]
}
