# skbouncer - build
#
# vmlinux.h is committed under src/ and is NOT regenerated by this Makefile:
# the fragmentation results are kernel-sensitive, so the BTF snapshot stays
# pinned to the kernel recorded in CLAUDE.md.

CLANG   ?= clang
BPFTOOL ?= bpftool
ARCH    := x86

CFLAGS     := -g -O2 -Wall
BPF_CFLAGS := -target bpf -D__TARGET_ARCH_$(ARCH) -g -O2 -Wall \
              -Wno-missing-declarations \
              -Isrc
LDLIBS     := -lbpf -lelf -lz

all: skbouncer

src/skbouncer.bpf.o: src/skbouncer.bpf.c src/vmlinux.h
	$(CLANG) $(BPF_CFLAGS) -c $< -o $@

src/skbouncer.skel.h: src/skbouncer.bpf.o
	$(BPFTOOL) gen skeleton $< > $@

skbouncer: src/main.c src/skbouncer.skel.h
	$(CLANG) $(CFLAGS) -Isrc src/main.c $(LDLIBS) -o $@

clean:
	rm -f src/skbouncer.bpf.o src/skbouncer.skel.h skbouncer

.PHONY: all clean

.DELETE_ON_ERROR:
